{
    "elements": [
        {
            "id":          "board_button",
            "type":        "button",
            "sprite":      "menus/boards/BoardButtonA",
            "anchor":      "center",
            "pivot":       "center",
            "aspect":      2.1176,
            "color":       [0.88, 0.88, 0.88, 1],
            "hover_color": [1, 1, 1, 1]
        },
        {
            "id":       "board_label",
            "type":     "label",
            "text":     "",
            "font":     "IMFellEnglish",
            "color":    [0.24, 0.15, 0.08, 1],
            "parent_hover_color": [0.463, 0.086, 0.071, 1],
            "anchor":   "center",
            "pivot":    "center",
            "position": { "x": "0%",  "y": "0.588%" },
            "size":     { "x": "64%", "y": "48%" }
        },
        {
            "id":       "title",
            "type":     "container",
            "anchor":   "top",
            "pivot":    "bottom",
            "position": { "x": "0%",  "y": "-3%" },
            "size":     { "x": "54%", "y": "48%" },
            "min_size": { "x": "300px", "y": "145px" },
            "aspect":   2.069,
            "elements": [
                {
                    "id":     "board",
                    "type":   "sprite",
                    "sprite": "menus/title/TitleBoard",
                    "anchor": "center",
                    "pivot":  "center",
                    "animation": {
                        "keyframes": [
                            { "time": 0.0,  "offset": { "y": 0.04 }, "alpha": 0 },
                            { "time": 0.4,  "ease": "out" },
                            { "time": 0.88 },
                            { "time": 0.93, "offset": { "y": -0.008 }, "rotation": 0.3, "ease": "out" },
                            { "time": 1.08, "ease": "in_out" }
                        ]
                    }
                },
                {
                    "id":     "slit",
                    "type":   "sprite",
                    "sprite": "menus/title/TitleSlit",
                    "anchor": { "x": 0.57719, "y": 0.5 },
                    "pivot":  "center",
                    "size":   { "x": "3.667%", "y": "2.414%" },
                    "animation": {
                        "keyframes": [
                            { "time": 0.0,  "alpha": 0 },
                            { "time": 0.88, "alpha": 0 },
                            { "time": 0.9 }
                        ]
                    }
                },
                {
                    "id":     "sword_slot",
                    "type":   "container",
                    "mask":   true,
                    "anchor": { "x": 0.57719, "y": 0.5 },
                    "pivot":  "top",
                    "size":   { "x": "29.75%", "y": "400%" },
                    "elements": [
                        {
                            "id":     "sword",
                            "type":   "sprite",
                            "sprite": "menus/title/TitleSword",
                            "anchor": "bottom",
                            "pivot":  { "x": 0.5, "y": 0.69853 },
                            "size":   { "x": "33.333%", "y": "11.724%" },
                            "animation": {
                                "delay": 0.5,
                                "keyframes": [
                                    { "time": 0.0,  "offset": { "y": 2.4 }, "rotation": 4 },
                                    { "time": 0.38, "rotation": -9, "ease": "in" },
                                    { "time": 0.47, "rotation": -3.5, "ease": "out" },
                                    { "time": 0.57, "rotation": -7.5, "ease": "in_out" },
                                    { "time": 0.67, "rotation": -5, "ease": "in_out" },
                                    { "time": 0.77, "rotation": -6.6, "ease": "in_out" },
                                    { "time": 0.86, "rotation": -6, "ease": "in_out" }
                                ]
                            }
                        }
                    ]
                },
                {
                    "id":     "glint",
                    "type":   "sprite",
                    "sprite": "menus/title/TitleGlint",
                    "anchor": { "x": 0.59165, "y": 0.78464 },
                    "pivot":  "center",
                    "size":   { "x": "5.833%", "y": "12.069%" },
                    "animation": {
                        "delay":        1.45,
                        "loop":         true,
                        "repeat_delay": 3.2,
                        "keyframes": [
                            { "time": 0.0, "scale": 0 },
                            { "time": 0.2, "scale": 1.3, "rotation": 30, "ease": "out" },
                            { "time": 0.5, "scale": 0, "rotation": 70, "ease": "in" }
                        ]
                    }
                }
            ]
        }
    ],
    "menus": [
        {
            "id":            "Main",
            "lock_input":    true,
            "raycast_input": true,
            "elements": [
                {
                    "id":  "title",
                    "ref": "MainMenu/title"
                },
                {
                    "id":       "boards",
                    "type":     "container",
                    "anchor":   "center",
                    "pivot":    "center",
                    "position": { "x": "0%",  "y": "-23%" },
                    "size":     { "x": "46%", "y": "34%" },
                    "aspect":   2.1176,
                    "animation": {
                        "delay": 1.0,
                        "keyframes": [
                            { "time": 0.0,  "offset": { "y": -0.08 }, "alpha": 0 },
                            { "time": 0.35, "ease": "out" }
                        ]
                    },
                    "elements": [
                        {
                            "id":       "continue",
                            "use":      "MainMenu/board_button",
                            "anchor":   "top_left",
                            "pivot":    "bottom_left",
                            "size":     { "x": "47%", "y": "47%" },
                            "on_click": {
                                "class":  "application.runtime.menueventsmanager.menus.MainMenuBranch",
                                "method": "closeMenu",
                                "arg":    "$parent"
                            },
                            "elements": [
                                { "id": "continueLabel", "use": "MainMenu/board_label", "text": "Continue" }
                            ]
                        },
                        {
                            "id":       "new_game",
                            "use":      "MainMenu/board_button",
                            "sprite":   "menus/boards/BoardButtonB",
                            "anchor":   "top_right",
                            "pivot":    "bottom_right",
                            "size":     { "x": "47%", "y": "47%" },
                            "elements": [
                                { "id": "newGameLabel", "use": "MainMenu/board_label", "text": "New Game" }
                            ]
                        },
                        {
                            "id":       "options",
                            "use":      "MainMenu/board_button",
                            "sprite":   "menus/boards/BoardButtonC",
                            "anchor":   "bottom_left",
                            "pivot":    "top_left",
                            "size":     { "x": "47%", "y": "47%" },
                            "elements": [
                                { "id": "optionsLabel", "use": "MainMenu/board_label", "text": "Options" }
                            ]
                        },
                        {
                            "id":       "quit",
                            "use":      "util/GenericButtons",
                            "anchor":   "bottom_right",
                            "pivot":    "top_right",
                            "size":     { "x": "47%", "y": "47%" },
                            "elements": [
                                { "id": "quitLabel", "use": "MainMenu/board_label", "text": "Quit" }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
