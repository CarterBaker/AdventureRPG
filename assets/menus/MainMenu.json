{
    "elements": [
        {
            "id":          "board_button",
            "type":        "button",
            "sprite":      "menus/boards/BoardButtonA",
            "anchor":      "center",
            "pivot":       "center",
            "aspect":      2.1176,
            "color":       [0.88, 0.88, 0.88, 1],
            "hover_color": [1, 1, 1, 1]
        },
        {
            "id":       "board_label",
            "type":     "label",
            "text":     "",
            "font":     "IMFellEnglish",
            "color":    [0.24, 0.15, 0.08, 1],
            "parent_hover_color": [0.463, 0.086, 0.071, 1],
            "anchor":   "center",
            "pivot":    "center",
            "position": { "x": "0%",  "y": "0.588%" },
            "size":     { "x": "64%", "y": "48%" }
        },
        {
            "id":          "character_slot",
            "type":        "button",
            "sprite":      "menus/paper/PaperStrip",
            "size":        { "x": "100%", "y": "50px" },
            "color":       [0.88, 0.88, 0.88, 1],
            "hover_color": [1, 1, 1, 1],
            "on_click": {
                "class":  "application.runtime.menueventsmanager.menus.LoadMenuBranch",
                "method": "loadCharacter"
            },
            "elements": [
                {
                    "id":       "character_label",
                    "type":     "label",
                    "font":     "IMFellEnglish",
                    "text":     "",
                    "color":    [0.24, 0.15, 0.08, 1],
                    "parent_hover_color": [0.463, 0.086, 0.071, 1],
                    "align":    "left",
                    "anchor":   "left",
                    "pivot":    "left",
                    "position": { "x": "7%", "y": "0%" },
                    "size":     { "x": "86%", "y": "100%" }
                }
            ]
        },
        {
            "id":       "character_list_empty",
            "type":     "label",
            "font":     "IMFellEnglish",
            "text":     "No saved characters",
            "color":    [0.88, 0.8, 0.66, 1],
            "size":     { "x": "100%", "y": "50px" }
        },
        {
            "id":       "title",
            "type":     "container",
            "anchor":   "top",
            "pivot":    "bottom",
            "position": { "x": "0%",  "y": "-3%" },
            "size":     { "x": "54%", "y": "48%" },
            "min_size": { "x": "300px", "y": "145px" },
            "aspect":   2.069,
            "elements": [
                {
                    "id":     "board",
                    "type":   "sprite",
                    "sprite": "menus/title/TitleBoard",
                    "anchor": "center",
                    "pivot":  "center",
                    "animation": {
                        "keyframes": [
                            { "time": 0.0,  "offset": { "y": 0.04 }, "alpha": 0 },
                            { "time": 0.4,  "ease": "out" },
                            { "time": 0.88 },
                            { "time": 0.93, "offset": { "y": -0.008 }, "rotation": 0.3, "ease": "out" },
                            { "time": 1.08, "ease": "in_out" }
                        ]
                    }
                },
                {
                    "id":     "slit",
                    "type":   "sprite",
                    "sprite": "menus/title/TitleSlit",
                    "anchor": { "x": 0.57719, "y": 0.5 },
                    "pivot":  "center",
                    "size":   { "x": "3.667%", "y": "2.414%" },
                    "animation": {
                        "keyframes": [
                            { "time": 0.0,  "alpha": 0 },
                            { "time": 0.88, "alpha": 0 },
                            { "time": 0.9 }
                        ]
                    }
                },
                {
                    "id":     "sword_slot",
                    "type":   "container",
                    "mask":   true,
                    "anchor": { "x": 0.57719, "y": 0.5 },
                    "pivot":  "top",
                    "size":   { "x": "29.75%", "y": "400%" },
                    "elements": [
                        {
                            "id":     "sword",
                            "type":   "sprite",
                            "sprite": "menus/title/TitleSword",
                            "anchor": "bottom",
                            "pivot":  { "x": 0.5, "y": 0.69853 },
                            "size":   { "x": "33.333%", "y": "11.724%" },
                            "animation": {
                                "delay": 0.5,
                                "keyframes": [
                                    { "time": 0.0,  "offset": { "y": 2.4 }, "rotation": 4 },
                                    { "time": 0.38, "rotation": -9, "ease": "in" },
                                    { "time": 0.47, "rotation": -3.5, "ease": "out" },
                                    { "time": 0.57, "rotation": -7.5, "ease": "in_out" },
                                    { "time": 0.67, "rotation": -5, "ease": "in_out" },
                                    { "time": 0.77, "rotation": -6.6, "ease": "in_out" },
                                    { "time": 0.86, "rotation": -6, "ease": "in_out" }
                                ]
                            }
                        }
                    ]
                },
                {
                    "id":     "glint",
                    "type":   "sprite",
                    "sprite": "menus/title/TitleGlint",
                    "anchor": { "x": 0.59165, "y": 0.78464 },
                    "pivot":  "center",
                    "size":   { "x": "5.833%", "y": "12.069%" },
                    "animation": {
                        "delay":        1.45,
                        "loop":         true,
                        "repeat_delay": 3.2,
                        "keyframes": [
                            { "time": 0.0, "scale": 0 },
                            { "time": 0.2, "scale": 1.3, "rotation": 30, "ease": "out" },
                            { "time": 0.5, "scale": 0, "rotation": 70, "ease": "in" }
                        ]
                    }
                }
            ]
        }
    ],
    "menus": [
        {
            "id":            "Main",
            "lock_input":    true,
            "raycast_input": true,
            "elements": [
                {
                    "id":  "title",
                    "ref": "MainMenu/title"
                },
                {
                    "id":       "boards",
                    "type":     "container",
                    "anchor":   "center",
                    "pivot":    "center",
                    "position": { "x": "0%",  "y": "-24%" },
                    "size":     { "x": "46%", "y": "43%" },
                    "aspect":   1.3841,
                    "animation": {
                        "delay": 1.0,
                        "keyframes": [
                            { "time": 0.0,  "offset": { "y": -0.08 }, "alpha": 0 },
                            { "time": 0.35, "ease": "out" }
                        ]
                    },
                    "elements": [
                        {
                            "id":       "continue",
                            "use":      "MainMenu/board_button",
                            "sprite":   "menus/boards/BoardButtonWide",
                            "anchor":   "top",
                            "pivot":    "bottom",
                            "size":     { "x": "94%", "y": "30.72%" },
                            "aspect":   4.2353,
                            "on_click": {
                                "class":  "application.runtime.menueventsmanager.menus.MainMenuBranch",
                                "method": "continueGame"
                            },
                            "elements": [
                                { "id": "continueLabel", "use": "MainMenu/board_label", "text": "Continue" }
                            ]
                        },
                        {
                            "id":       "load",
                            "use":      "MainMenu/board_button",
                            "anchor":   "left",
                            "pivot":    "left",
                            "size":     { "x": "47%", "y": "30.72%" },
                            "on_click": {
                                "class":  "application.runtime.menueventsmanager.menus.LoadMenuBranch",
                                "method": "openMenu"
                            },
                            "elements": [
                                { "id": "loadLabel", "use": "MainMenu/board_label", "text": "Load" }
                            ]
                        },
                        {
                            "id":       "new_game",
                            "use":      "MainMenu/board_button",
                            "sprite":   "menus/boards/BoardButtonB",
                            "anchor":   "right",
                            "pivot":    "right",
                            "size":     { "x": "47%", "y": "30.72%" },
                            "on_click": {
                                "class":  "application.runtime.menueventsmanager.menus.MainMenuBranch",
                                "method": "newGame"
                            },
                            "elements": [
                                { "id": "newGameLabel", "use": "MainMenu/board_label", "text": "New Game" }
                            ]
                        },
                        {
                            "id":       "options",
                            "use":      "MainMenu/board_button",
                            "sprite":   "menus/boards/BoardButtonC",
                            "anchor":   "bottom_left",
                            "pivot":    "top_left",
                            "size":     { "x": "47%", "y": "30.72%" },
                            "elements": [
                                { "id": "optionsLabel", "use": "MainMenu/board_label", "text": "Options" }
                            ]
                        },
                        {
                            "id":       "quit",
                            "use":      "util/GenericButtons",
                            "anchor":   "bottom_right",
                            "pivot":    "top_right",
                            "size":     { "x": "47%", "y": "30.72%" },
                            "elements": [
                                { "id": "quitLabel", "use": "MainMenu/board_label", "text": "Quit" }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id":            "Load",
            "lock_input":    true,
            "raycast_input": true,
            "entry_points":  ["character_list"],
            "elements": [
                {
                    "id":       "panel",
                    "type":     "sprite",
                    "sprite":   "menus/wood/WoodPanel",
                    "anchor":   "center",
                    "pivot":    "center",
                    "position": { "x": "0%", "y": "0%" },
                    "size":     { "x": "26%", "y": "72%" },
                    "min_size": { "x": "280px", "y": "360px" },
                    "animation": {
                        "keyframes": [
                            { "time": 0.0,  "offset": { "y": -0.08 }, "alpha": 0 },
                            { "time": 0.35, "ease": "out" }
                        ]
                    },
                    "elements": [
                        {
                            "id":       "title_note",
                            "type":     "sprite",
                            "sprite":   "menus/paper/PaperScrap",
                            "anchor":   "top",
                            "pivot":    "bottom",
                            "position": { "x": "0%", "y": "-12px" },
                            "size":     { "x": "calc(100% - 50px)", "y": "56px" },
                            "aspect":   3.6111,
                            "elements": [
                                {
                                    "id":       "title_label",
                                    "type":     "label",
                                    "font":     "IMFellEnglish",
                                    "text":     "Load",
                                    "color":    [0.16, 0.1, 0.06, 1],
                                    "anchor":   "center",
                                    "pivot":    "center",
                                    "position": { "x": "0%", "y": "2%" },
                                    "size":     { "x": "70%", "y": "70%" }
                                }
                            ]
                        },
                        {
                            "id":       "character_list",
                            "type":     "container",
                            "mask":     true,
                            "stack":    "vertical",
                            "spacing":  "4px",
                            "anchor":   "top_left",
                            "pivot":    "bottom_left",
                            "position": { "x": "22px", "y": "-76px" },
                            "size":     { "x": "calc(100% - 44px)", "y": "calc(100% - 158px)" }
                        },
                        {
                            "id":          "back",
                            "type":        "button",
                            "sprite":      "menus/paper/PaperStrip",
                            "anchor":      "bottom",
                            "pivot":       "top",
                            "position":    { "x": "0%", "y": "22px" },
                            "size":        { "x": "calc(100% - 44px)", "y": "50px" },
                            "color":       [0.88, 0.88, 0.88, 1],
                            "hover_color": [1, 1, 1, 1],
                            "on_click": {
                                "class":  "application.runtime.menueventsmanager.menus.LoadMenuBranch",
                                "method": "closeMenu"
                            },
                            "elements": [
                                {
                                    "id":       "back_label",
                                    "type":     "label",
                                    "font":     "IMFellEnglish",
                                    "text":     "Back",
                                    "color":    [0.24, 0.15, 0.08, 1],
                                    "parent_hover_color": [0.463, 0.086, 0.071, 1],
                                    "anchor":   "center",
                                    "pivot":    "center",
                                    "size":     { "x": "86%", "y": "100%" }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
