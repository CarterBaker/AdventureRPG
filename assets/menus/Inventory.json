{
    "elements": [],
    "menus": [
        {
            "id": "Inventory",
            "lock_input":    true,
            "raycast_input": true,
            "entry_points": ["item_list", "scroll_handle"],
            "elements": [
                {
                    "id": "panel",
                    "type": "sprite",
                    "sprite": "menus/wood/WoodPanel",
                    "anchor": "left",
                    "pivot":  "left",
                    "position": { "x": "1%", "y": "0%" },
                    "size":     { "x": "22%", "y": "80%" },
                    "min_size": { "x": "240px", "y": "320px" },
                    "animation": {
                        "keyframes": [
                            { "time": 0.0,  "offset": { "x": -1.2 } },
                            { "time": 0.35, "ease": "out" }
                        ]
                    },
                    "elements": [
                        {
                            "id": "title_note",
                            "type": "sprite",
                            "sprite": "menus/paper/PaperScrap",
                            "anchor":   "top",
                            "pivot":    "bottom",
                            "position": { "x": "0%", "y": "-12px" },
                            "size":     { "x": "calc(100% - 50px)", "y": "56px" },
                            "aspect":   3.6111,
                            "elements": [
                                {
                                    "id": "title_label",
                                    "type": "label",
                                    "font":  "IMFellEnglish",
                                    "text":  "Inventory",
                                    "color": [0.16, 0.1, 0.06, 1],
                                    "anchor":   "center",
                                    "pivot":    "center",
                                    "position": { "x": "0%", "y": "2%" },
                                    "size":     { "x": "70%", "y": "70%" }
                                }
                            ]
                        },
                        {
                            "id": "item_list",
                            "type": "container",
                            "mask": true,
                            "stack": "vertical",
                            "spacing": "4px",
                            "anchor": "top_left",
                            "pivot":  "bottom_left",
                            "position": { "x": "22px", "y": "-76px" },
                            "size":     { "x": "calc(100% - 80px)", "y": "calc(100% - 100px)" }
                        },
                        {
                            "id": "scrollbar_track",
                            "type": "sprite",
                            "sprite": "menus/wood/WoodSlat",
                            "anchor": "top_right",
                            "pivot":  "bottom_right",
                            "position": { "x": "-22px", "y": "-76px" },
                            "size":     { "x": "28px", "y": "calc(100% - 100px)" },
                            "elements": [
                                {
                                    "id": "scroll_handle",
                                    "type": "sprite",
                                    "sprite": "menus/wood/WoodPeg",
                                    "anchor":   "top",
                                    "pivot":    "bottom",
                                    "position": { "x": "0%", "y": "-6px" },
                                    "size":     { "x": "calc(100% - 8px)", "y": "20%" }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
