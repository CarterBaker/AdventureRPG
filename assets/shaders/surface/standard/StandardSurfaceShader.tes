#version 400 core
layout(quads, equal_spacing, ccw) in;

in vec3  teWorldPos[];
in vec3  teNormal[];
in vec2  teUVOrigin[];
in float teOrient[];
in vec3  teColor[];
in float teSizeA[];
in float teSizeB[];
in float teNatural[];
in float teEdgeCells[];
in vec4  teEdgeLow[];
in vec4  teEdgeHigh[];

out vec3 vLocalPos;
out vec3 vUVLocalPos;
out vec3 vNormal;
flat out vec2 vUVOrigin;
flat out float vOrient;
out vec3 vColor;

#include "includes/CameraData.glsl"
#include "includes/SettingsData.glsl"
#include "includes/PlayerPositionData.glsl"
#include "includes/WorldCurvature.glsl"
#include "surface/includes/SurfaceStandard.glsl"
#include "includes/BlockOrientationMapData.glsl"
#include "surface/includes/TiledSampling.glsl"
#include "surface/includes/SurfaceTessellationTier.glsl"
#include "surface/includes/NearTerrainNoise.glsl"
#include "surface/includes/Bevel.glsl"
#include "surface/includes/HeightDisplacement.glsl"

// Terrain tessellation evaluation. What closes every seam is that nothing here depends on which patch is
// evaluating a vertex. The tessellated position is snapped to the quarter-block lattice every vertex ideally
// lies on, so a vertex shared by two patches of different sizes starts from bit-identical input; the patch's
// tangents are exact axis signs, so its local coordinates are exact too; and the bevel and the weight of every
// detail layer come from the window of sub-blocks around the vertex (see Bevel.glsl), which every patch
// touching it rebuilds identically from its own edge columns. Natural distortion and height relief therefore
// fade to exactly zero wherever two surfaces meet, and the only displacement surviving there is the bevel,
// itself a pure function of the vertex. An artificial patch is never displaced, and every natural neighbour
// fades flat against it. World curvature bends the finished position once, after everything else, so normals
// and every lookup keep using the flat position. Geometric normals come from finite differences in block
// units, taken only where displacement actually runs, so a ten-block quad and a half-block quad shade to the
// same gradient.

const float HEIGHT_FD_EPSILON_BLOCKS = 0.02;

vec3 evalDisplacedSurface(
    vec3 baseWorldPos,
    vec3 tangentA, vec3 tangentB, vec3 normal,
    int sizeASub, int sizeBSub, int cellsPerEntry,
    float nearStrength) {

    if (nearStrength <= 0.001 || teNatural[0] < 0.5)
    return baseWorldPos;

    SurfaceWindow window = buildSurfaceWindow(
        baseWorldPos, teWorldPos[0],
        tangentA, tangentB, normal,
        sizeASub, sizeBSub, cellsPerEntry,
        teEdgeLow[0], teEdgeHigh[0]);

    vec3  bevelOffset;
    float detailWeight;
    resolveSurfaceShape(window, baseWorldPos, bevelOffset, detailWeight);

    float weight   = detailWeight * nearStrength;
    vec3  worldPos = applyNaturalSurfaceNoise(baseWorldPos, baseWorldPos, normal, weight);

    vec2 tiledUV = tileUV(baseWorldPos, teUVOrigin[0], normal, teOrient[0]);
    worldPos = applyHeightDisplacement(worldPos, baseWorldPos, normal, tiledUV, weight);

    return worldPos + bevelOffset * nearStrength;
}

void main() {

    float u = gl_TessCoord.x;
    float v = gl_TessCoord.y;

    float sizeA = teSizeA[0];
    float sizeB = teSizeB[0];

    int sizeASub      = int(round(sizeA / SUB_BLOCK_SIZE));
    int sizeBSub      = int(round(sizeB / SUB_BLOCK_SIZE));
    int cellsPerEntry = int(round(teEdgeCells[0]));

    vec3 origin   = teWorldPos[0];
    vec3 normal   = teNormal[0];
    vec3 tangentA = sign(teWorldPos[1] - origin);
    vec3 tangentB = sign(teWorldPos[3] - origin);

    vec3 baseWorldPos = snapToTessellationLattice(
        mix(mix(teWorldPos[0], teWorldPos[1], u),
            mix(teWorldPos[3], teWorldPos[2], u), v));

    float tier0MaxSqDist = getTier0MaxSqDist();
    float nearStrength   = getNearStrength(computeDistanceFromCenterSq(baseWorldPos), tier0MaxSqDist);

    vec3 worldPos = evalDisplacedSurface(
        baseWorldPos, tangentA, tangentB, normal, sizeASub, sizeBSub, cellsPerEntry, nearStrength);

    if (nearStrength > 0.001 && teNatural[0] >= 0.5) {

        float posA = dot(baseWorldPos - origin, tangentA);
        float posB = dot(baseWorldPos - origin, tangentB);

        float stepA = HEIGHT_FD_EPSILON_BLOCKS;
        float stepB = HEIGHT_FD_EPSILON_BLOCKS;

        stepA = (posA + stepA <= sizeA) ? stepA : -stepA;
        stepB = (posB + stepB <= sizeB) ? stepB : -stepB;

        vec3 baseA = baseWorldPos + tangentA * stepA;
        vec3 baseB = baseWorldPos + tangentB * stepB;

        float nearStrengthA = getNearStrength(computeDistanceFromCenterSq(baseA), tier0MaxSqDist);
        float nearStrengthB = getNearStrength(computeDistanceFromCenterSq(baseB), tier0MaxSqDist);

        vec3 posAlongA = evalDisplacedSurface(
            baseA, tangentA, tangentB, normal, sizeASub, sizeBSub, cellsPerEntry, nearStrengthA);
        vec3 posAlongB = evalDisplacedSurface(
            baseB, tangentA, tangentB, normal, sizeASub, sizeBSub, cellsPerEntry, nearStrengthB);

        vec3 derivativeA = (posAlongA - worldPos) / stepA;
        vec3 derivativeB = (posAlongB - worldPos) / stepB;

        if (length(derivativeA) > 1e-6 && length(derivativeB) > 1e-6) {
            vec3 fdNormal = normalize(cross(derivativeA, derivativeB));
            if (dot(fdNormal, normal) < 0.0)
            fdNormal = -fdNormal;
            normal = fdNormal;
        }
    }

    vLocalPos   = worldPos;
    vUVLocalPos = baseWorldPos;
    vNormal     = normal;
    vUVOrigin   = teUVOrigin[0];
    vOrient     = teOrient[0];
    vColor      = mix(mix(teColor[0], teColor[1], u),
                      mix(teColor[3], teColor[2], u), v);

    gl_Position = u_viewProjection * vec4(applyWorldCurvature(worldPos), 1.0);
}
