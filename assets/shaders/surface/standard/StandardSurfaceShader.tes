#version 400 core
layout(quads, equal_spacing, ccw) in;

in vec3  teWorldPos[];
in vec3  teNormal[];
in vec2  teUVOrigin[];
in float teOrient[];
in float teColor[];
in float teQuadSize[];
in float teBevelMaskA0[];
in float teBevelMaskA1[];
in float teBevelMaskB0[];
in float teBevelMaskB1[];

out vec3 vLocalPos;
out vec3 vUVLocalPos;
out vec3 vNormal;
flat out vec2 vUVOrigin;
flat out float vOrient;
out float vColor;

#include "includes/CameraData.glsl"
#include "includes/SettingsData.glsl"
#include "includes/PlayerPositionData.glsl"
#include "includes/WorldCurvature.glsl"
#include "includes/WorldDistantRise.glsl"
#include "includes/NaturalNoiseData.glsl"
#include "surface/includes/SurfaceStandard.glsl"
#include "includes/BlockOrientationMapData.glsl"
#include "surface/includes/TiledSampling.glsl"
#include "surface/includes/SurfaceTessellationTier.glsl"

/*
 * Terrain tessellation evaluation. Displaces the near ring with per-vertex
 * height/noise, bevels a natural block's exposed convex edges inward, and
 * stretches an artificial block's edge outward wherever a natural neighbor
 * bevels away from it, before applying the shared distant-rise and world
 * curvature bends. Bevel/height edge strength is driven entirely by each
 * edge's own per-cell exposure mask (FullGeometryBranch.isConvexExposedOnSide
 * / isStretchExposedOnSide), so the same physical edge always resolves the
 * same way regardless of which quad or chunk batch is evaluating it.
 */

const float BEVEL_RADIUS = 0.30;
const float BEVEL_SIZE   = 0.09;
const float MASK_BLEND   = 0.15;

const float HEIGHT_DISPLACE_SCALE   = 0.12;
const float HEIGHT_FD_EPSILON       = 0.02;
const float HEIGHT_EDGE_FADE_RADIUS = 0.75;

float maskBit(float mask, int bit) {
    return float((int(mask) >> bit) & 1);
}

float maskBitSmooth(float mask, float pos, int lastIndex) {
    int idx = clamp(int(floor(pos)), 0, lastIndex);
    float thisBit = maskBit(mask, idx);

    float nearestBoundary = floor(pos + 0.5);
    int   boundaryIdx      = int(nearestBoundary);

    if (boundaryIdx <= 0 || boundaryIdx > lastIndex)
        return thisBit;

    float dist = pos - nearestBoundary;

    float belowBit = maskBit(mask, boundaryIdx - 1);
    float aboveBit = maskBit(mask, boundaryIdx);

    float t = smoothstep(-MASK_BLEND * 0.5, MASK_BLEND * 0.5, dist);
    return mix(belowBit, aboveBit, t);
}

// Edge strength comes only from a mask's own distance falloff, never from
// the perpendicular edge's mask — cross-referencing it forced strength to
// zero at internal seams and multi-face corners. A true convex corner still
// rounds correctly with no extra casing: both adjoining edges independently
// reach full strength approaching the corner, and the caller combines their
// pushes into one capped diagonal displacement (see evalDisplacedSurface).
vec2 computeEdgeExposure(
    float posA, float posB,
    float sizeA, float sizeB,
    int iLastA, int iLastB,
    float maskA0, float maskA1, float maskB0, float maskB1,
    float radius) {

    float rawA0 = 1.0 - smoothstep(0.0, radius, posA);
    float rawA1 = 1.0 - smoothstep(0.0, radius, sizeA - posA);
    float rawB0 = 1.0 - smoothstep(0.0, radius, posB);
    float rawB1 = 1.0 - smoothstep(0.0, radius, sizeB - posB);

    float edgeA0 = rawA0 * maskBitSmooth(maskA0, posB, iLastB);
    float edgeA1 = rawA1 * maskBitSmooth(maskA1, posB, iLastB);
    float edgeB0 = rawB0 * maskBitSmooth(maskB0, posA, iLastA);
    float edgeB1 = rawB1 * maskBitSmooth(maskB1, posA, iLastA);

    return vec2(max(edgeA0, edgeA1), max(edgeB0, edgeB1));
}

vec3 evalDisplacedSurface(float u, float v, float tier0MaxSqDist, float tier1MaxSqDist, out vec3 outNormal) {

    vec3 worldPos   = mix(mix(teWorldPos[0], teWorldPos[1], u),
                          mix(teWorldPos[3], teWorldPos[2], u), v);
    vec3 uvLocalPos = worldPos;

    vec3 normal = normalize(
                  mix(mix(teNormal[0], teNormal[1], u),
                      mix(teNormal[3], teNormal[2], u), v));

    float vertexDistSq = computeDistanceFromCenterSq(worldPos);
    float nearStrength  = vertexDistSq <= tier0MaxSqDist ? 1.0 : 0.0;

    vec2 seed = worldPos.xz;

    if (nearStrength > 0.001) {
        vec2  nSeed = seed * NATURAL_NOISE_SEED_SCALE;
        float nX    = sampleNaturalNoiseSmooth(nSeed + vec2(17.3,  0.0)) - 0.5;
        float nZ    = sampleNaturalNoiseSmooth(nSeed + vec2( 0.0, 31.7)) - 0.5;
        float nY    = sampleNaturalNoiseSmooth(nSeed + vec2(53.1, 83.2)) - 0.5;
        worldPos.x += nX * 0.4  * nearStrength;
        worldPos.z += nZ * 0.4  * nearStrength;
        worldPos.y += nY * 0.08 * nearStrength;
    }

    if (vertexDistSq > tier1MaxSqDist)
        worldPos = applyDistantRise(worldPos);

    if (nearStrength > 0.001) {
        int   quadPack = int(teQuadSize[0]);
        float sizeA    = float(quadPack & 0xFF);
        float sizeB    = float((quadPack >> 8) & 0xFF);

        // A negative mask marks an artificial quad's outward STRETCH data
        // rather than a natural quad's inward BEVEL data (see
        // FullGeometryBranch.isStretchExposedOnSide) — every mask on one
        // quad shares a single sign, since a quad belongs to one block that
        // is either natural or not. Bit extraction always reads the
        // unsigned magnitude; GLSL's arithmetic right shift would otherwise
        // recover the wrong bits from a two's-complement negative value.
        float maskA0 = teBevelMaskA0[0];
        float maskA1 = teBevelMaskA1[0];
        float maskB0 = teBevelMaskB0[0];
        float maskB1 = teBevelMaskB1[0];

        bool  isStretch = maskA0 < 0.0 || maskA1 < 0.0 || maskB0 < 0.0 || maskB1 < 0.0;
        float pushSign  = isStretch ? -1.0 : 1.0;

        float absMaskA0 = abs(maskA0);
        float absMaskA1 = abs(maskA1);
        float absMaskB0 = abs(maskB0);
        float absMaskB1 = abs(maskB1);

        float posA = u * sizeA;
        float posB = v * sizeB;

        int iLastA = int(sizeA) - 1;
        int iLastB = int(sizeB) - 1;

        vec2  bevelAxes = computeEdgeExposure(posA, posB, sizeA, sizeB, iLastA, iLastB,
                                               absMaskA0, absMaskA1, absMaskB0, absMaskB1, BEVEL_RADIUS);
        float bevelA    = bevelAxes.x;
        float bevelB    = bevelAxes.y;
        float bevelMax  = max(bevelA, bevelB);

        if (bevelMax > 0.001) {

            vec3 quadTangentA = normalize(teWorldPos[1] - teWorldPos[0]);
            vec3 quadTangentB = normalize(teWorldPos[3] - teWorldPos[0]);

            vec3 towardCenterA = quadTangentA * sign(0.5 - u);
            vec3 towardCenterB = quadTangentB * sign(0.5 - v);

            // bevelA and bevelB independently reach 1.0 right at a true
            // corner, so pushing the full amount along both axes at once
            // reached BEVEL_SIZE*sqrt(2) there — deeper than any single
            // edge, deep enough to cut into (or, for a stretch quad,
            // overshoot past) whatever neighboring geometry the corner is
            // supposed to meet. Capping the combined push to length <= 1
            // before scaling reproduces the exact single-axis push along a
            // straight edge and rounds smoothly into a same-depth corner.
            vec2  pushAxes   = vec2(bevelA, bevelB);
            float pushLen    = length(pushAxes);
            vec2  pushVector = pushLen > 0.0001 ? (pushAxes / pushLen) * min(pushLen, 1.0) : vec2(0.0);

            worldPos += towardCenterA * (BEVEL_SIZE * pushSign) * pushVector.x;
            worldPos += towardCenterB * (BEVEL_SIZE * pushSign) * pushVector.y;
            worldPos -= normal * BEVEL_SIZE * bevelMax;

            vec3  edgeDir = -towardCenterA * pushVector.x - towardCenterB * pushVector.y;
            float edgeLen = length(edgeDir);
            if (edgeLen > 0.001) {
                normal = normalize(mix(normal, edgeDir / edgeLen, bevelMax));
            }
        }

        vec2  heightEdgeAxes = computeEdgeExposure(posA, posB, sizeA, sizeB, iLastA, iLastB,
                                                    absMaskA0, absMaskA1, absMaskB0, absMaskB1, HEIGHT_EDGE_FADE_RADIUS);
        float heightWeight = 1.0 - max(heightEdgeAxes.x, heightEdgeAxes.y);

        vec2  tiledUV = tileUV(uvLocalPos, teUVOrigin[0], normal, teOrient[0]);
        float h       = texture(u_textureArray, vec3(tiledUV, float(u_layer_height))).r;
        worldPos += normal * (h - 0.5) * HEIGHT_DISPLACE_SCALE * heightWeight * nearStrength;
    }

    worldPos = applyWorldCurvature(worldPos);

    outNormal = normal;
    return worldPos;
}

void main() {

    float u = gl_TessCoord.x;
    float v = gl_TessCoord.y;

    float tier0MaxSqDist = getTier0MaxSqDist();
    float tier1MaxSqDist = getTier1MaxSqDist();

    vec3 normal;
    vec3 worldPos = evalDisplacedSurface(u, v, tier0MaxSqDist, tier1MaxSqDist, normal);

    float distSq          = computeDistanceFromCenterSq(worldPos);
    float nearStrength0   = distSq <= tier0MaxSqDist ? 1.0 : 0.0;
    float farRingActive0  = distSq > tier1MaxSqDist  ? 1.0 : 0.0;
    float geometryBlend   = max(nearStrength0, farRingActive0);

    if (geometryBlend > 0.001) {
        float uStep = (u + HEIGHT_FD_EPSILON <= 1.0) ?  HEIGHT_FD_EPSILON : -HEIGHT_FD_EPSILON;
        float vStep = (v + HEIGHT_FD_EPSILON <= 1.0) ?  HEIGHT_FD_EPSILON : -HEIGHT_FD_EPSILON;

        vec3 dummyNormal;
        vec3 posU = evalDisplacedSurface(u + uStep, v, tier0MaxSqDist, tier1MaxSqDist, dummyNormal);
        vec3 posV = evalDisplacedSurface(u, v + vStep, tier0MaxSqDist, tier1MaxSqDist, dummyNormal);

        vec3 tangentU = (posU - worldPos) / uStep;
        vec3 tangentV = (posV - worldPos) / vStep;

        if (length(tangentU) > 1e-6 && length(tangentV) > 1e-6) {
            vec3 fdNormal = normalize(cross(tangentU, tangentV));
            if (dot(fdNormal, normal) < 0.0)
                fdNormal = -fdNormal;
            normal = normalize(mix(normal, fdNormal, geometryBlend));
        }
    }

    vec3 uvLocalPos = mix(mix(teWorldPos[0], teWorldPos[1], u),
                          mix(teWorldPos[3], teWorldPos[2], u), v);

    vLocalPos   = worldPos;
    vUVLocalPos = uvLocalPos;
    vNormal     = normal;
    vUVOrigin   = teUVOrigin[0];
    vOrient     = teOrient[0];
    vColor = mix(mix(teColor[0], teColor[1], u),
                 mix(teColor[3], teColor[2], u), v);

    gl_Position = u_viewProjection * vec4(worldPos, 1.0);
}