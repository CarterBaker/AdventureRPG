#version 400 core
layout(quads, equal_spacing, ccw) in;

in vec3  teWorldPos[];
in vec3  teNormal[];
in vec2  teUVOrigin[];
in float teOrient[];
in float teColor[];
in float teQuadSize[];
in float teBevelMaskA0[];
in float teBevelMaskA1[];
in float teBevelMaskB0[];
in float teBevelMaskB1[];
in float teBevelNegMaskA0[];
in float teBevelNegMaskA1[];
in float teBevelNegMaskB0[];
in float teBevelNegMaskB1[];

out vec3 vLocalPos;
out vec3 vUVLocalPos;
out vec3 vNormal;
flat out vec2 vUVOrigin;
flat out float vOrient;
out float vColor;

#include "includes/CameraData.glsl"
#include "includes/SettingsData.glsl"
#include "includes/PlayerPositionData.glsl"
#include "includes/WorldCurvature.glsl"
#include "includes/WorldDistantRise.glsl"
#include "surface/includes/SurfaceStandard.glsl"
#include "includes/BlockOrientationMapData.glsl"
#include "surface/includes/TiledSampling.glsl"
#include "surface/includes/SurfaceTessellationTier.glsl"
#include "surface/includes/NearTerrainNoise.glsl"
#include "surface/includes/Bevel.glsl"
#include "surface/includes/HeightDisplacement.glsl"

// Terrain tessellation evaluation. Tier and nearStrength decisions derive from the bilinearly interpolated base position before any displacement, so two patches sharing a boundary edge always agree on the displacement magnitude there; towardCenterA/B use a sign that never returns 0 so bevel never disappears on a quad's center row.

const float HEIGHT_FD_EPSILON = 0.02;

float safeSign(float t) {
    return t >= 0.5 ? -1.0 : 1.0;
}

vec3 evalDisplacedSurface(
    float u, float v,
    float tier0MaxSqDist, float tier1MaxSqDist,
    vec3 baseWorldPos, float nearStrength,
    out vec3 outNormal) {

    vec3 worldPos = baseWorldPos;

    vec3 normal = normalize(
        mix(mix(teNormal[0], teNormal[1], u),
            mix(teNormal[3], teNormal[2], u), v));

    worldPos = applyNearTerrainJitter(worldPos, nearStrength);

    if (computeDistanceFromCenterSq(baseWorldPos) > tier1MaxSqDist)
        worldPos = applyDistantRise(worldPos);

    if (nearStrength > 0.001) {

        int   quadPack = int(teQuadSize[0]);
        float sizeA    = float(quadPack & 0xFF);
        float sizeB    = float((quadPack >> 8) & 0xFF);

        float posA = u * sizeA;
        float posB = v * sizeB;

        int iLastA = int(sizeA) - 1;
        int iLastB = int(sizeB) - 1;

        vec3 quadTangentA  = normalize(teWorldPos[1] - teWorldPos[0]);
        vec3 quadTangentB  = normalize(teWorldPos[3] - teWorldPos[0]);
        vec3 towardCenterA = quadTangentA * safeSign(u);
        vec3 towardCenterB = quadTangentB * safeSign(v);

        applyBevel(
            worldPos, normal,
            towardCenterA, towardCenterB,
            posA, posB, sizeA, sizeB, iLastA, iLastB,
            teBevelMaskA0[0], teBevelMaskA1[0], teBevelMaskB0[0], teBevelMaskB1[0],
            teBevelNegMaskA0[0], teBevelNegMaskA1[0], teBevelNegMaskB0[0], teBevelNegMaskB1[0]);

        vec2 tiledUV = tileUV(baseWorldPos, teUVOrigin[0], normal, teOrient[0]);
        worldPos = applyHeightDisplacement(
            worldPos, normal, tiledUV,
            posA, posB, sizeA, sizeB, iLastA, iLastB,
            teBevelMaskA0[0], teBevelMaskA1[0], teBevelMaskB0[0], teBevelMaskB1[0],
            nearStrength);
    }

    worldPos = applyWorldCurvature(worldPos);

    outNormal = normal;
    return worldPos;
}

void main() {

    float u = gl_TessCoord.x;
    float v = gl_TessCoord.y;

    float tier0MaxSqDist = getTier0MaxSqDist();
    float tier1MaxSqDist = getTier1MaxSqDist();

    vec3 baseWorldPos = mix(mix(teWorldPos[0], teWorldPos[1], u),
                            mix(teWorldPos[3], teWorldPos[2], u), v);

    float baseDistSq   = computeDistanceFromCenterSq(baseWorldPos);
    float nearStrength = getNearStrength(baseDistSq, tier0MaxSqDist);

    vec3 normal;
    vec3 worldPos = evalDisplacedSurface(
        u, v, tier0MaxSqDist, tier1MaxSqDist, baseWorldPos, nearStrength, normal);

    float farRingActive = baseDistSq > tier1MaxSqDist ? 1.0 : 0.0;
    float geometryBlend = max(nearStrength, farRingActive);

    if (geometryBlend > 0.001) {
        float uStep = (u + HEIGHT_FD_EPSILON <= 1.0) ?  HEIGHT_FD_EPSILON : -HEIGHT_FD_EPSILON;
        float vStep = (v + HEIGHT_FD_EPSILON <= 1.0) ?  HEIGHT_FD_EPSILON : -HEIGHT_FD_EPSILON;

        vec3 baseU = mix(mix(teWorldPos[0], teWorldPos[1], u + uStep),
                         mix(teWorldPos[3], teWorldPos[2], u + uStep), v);
        vec3 baseV = mix(mix(teWorldPos[0], teWorldPos[1], u),
                         mix(teWorldPos[3], teWorldPos[2], u), v + vStep);

        float nsU = getNearStrength(computeDistanceFromCenterSq(baseU), tier0MaxSqDist);
        float nsV = getNearStrength(computeDistanceFromCenterSq(baseV), tier0MaxSqDist);

        vec3 dummyNormal;
        vec3 posU = evalDisplacedSurface(u + uStep, v, tier0MaxSqDist, tier1MaxSqDist, baseU, nsU, dummyNormal);
        vec3 posV = evalDisplacedSurface(u, v + vStep, tier0MaxSqDist, tier1MaxSqDist, baseV, nsV, dummyNormal);

        vec3 tangentU = (posU - worldPos) / uStep;
        vec3 tangentV = (posV - worldPos) / vStep;

        if (length(tangentU) > 1e-6 && length(tangentV) > 1e-6) {
            vec3 fdNormal = normalize(cross(tangentU, tangentV));
            if (dot(fdNormal, normal) < 0.0)
                fdNormal = -fdNormal;
            normal = normalize(mix(normal, fdNormal, geometryBlend));
        }
    }

    vLocalPos   = worldPos;
    vUVLocalPos = baseWorldPos;
    vNormal     = normal;
    vUVOrigin   = teUVOrigin[0];
    vOrient     = teOrient[0];
    vColor = mix(mix(teColor[0], teColor[1], u),
                 mix(teColor[3], teColor[2], u), v);

    gl_Position = u_viewProjection * vec4(worldPos, 1.0);
}