#version 400 core
layout(quads, equal_spacing, ccw) in;

in vec3  teWorldPos[];
in vec3  teNormal[];
in vec2  teUVOrigin[];
in float teOrient[];
in vec3  teColor[];
in float teSizeA[];
in float teSizeB[];
in float teNatural[];
in vec4  teEdge[];

out vec3 vLocalPos;
out vec3 vUVLocalPos;
out vec3 vNormal;
flat out vec2 vUVOrigin;
flat out float vOrient;
out vec3 vColor;

#include "includes/CameraData.glsl"
#include "includes/SettingsData.glsl"
#include "includes/PlayerPositionData.glsl"
#include "includes/WorldCurvature.glsl"
#include "includes/WorldDistantRise.glsl"
#include "surface/includes/SurfaceStandard.glsl"
#include "includes/BlockOrientationMapData.glsl"
#include "surface/includes/TiledSampling.glsl"
#include "surface/includes/SurfaceTessellationTier.glsl"
#include "surface/includes/NearTerrainNoise.glsl"
#include "surface/includes/Bevel.glsl"
#include "surface/includes/HeightDisplacement.glsl"

// Terrain tessellation evaluation. The order is what makes a seam close: natural distortion and height
// relief are scaled by a weight that reaches exactly zero on any edge cell where the surface ends, so at
// such an edge the only surviving displacement is the bevel, and the bevel solver is symmetric across the
// two faces that meet there. Edge state is interpolated between cell centers rather than stepped per cell,
// which both removes the clamp that made two faces read different cells at a quad's end and lets a
// non-natural surface follow a natural neighbour's bevel across one cell. Distant rise is applied
// unconditionally rather than behind a per-vertex distance test, because that test stepped a 64-block
// displacement on and off inside a single patch; the function's own clamp already zeroes it for near
// terrain. Geometric normals come from finite differences in block units, taken only where displacement
// actually runs, so a ten-block quad and a one-block quad shade to the same gradient.

const float HEIGHT_FD_EPSILON_BLOCKS = 0.02;

vec3 evalDisplacedSurface(
    float u, float v, vec3 baseWorldPos,
    float sizeA, float sizeB, float natural,
    vec3 tangentA, vec3 tangentB, vec3 normal,
    float nearStrength) {

    vec3 worldPos = baseWorldPos;

    if (nearStrength > 0.001) {

        float posA = u * sizeA;
        float posB = v * sizeB;

        float distA, distB;
        float signedA, signedB;
        float fadeFlagA, fadeFlagB;
        vec3  outwardA, outwardB;

        resolveAxis(posA, sizeA, posB, sizeB, teEdge[0].x, teEdge[0].y, tangentA,
                    distA, signedA, fadeFlagA, outwardA);
        resolveAxis(posB, sizeB, posA, sizeA, teEdge[0].z, teEdge[0].w, tangentB,
                    distB, signedB, fadeFlagB, outwardB);

        float boundary     = max(edgeFade(distA, fadeFlagA), edgeFade(distB, fadeFlagB));
        float detailWeight = natural * (1.0 - boundary) * nearStrength;

        worldPos = applyNaturalSurfaceNoise(worldPos, baseWorldPos, normal, detailWeight);

        vec2 tiledUV = tileUV(baseWorldPos, teUVOrigin[0], normal, teOrient[0]);
        worldPos = applyHeightDisplacement(worldPos, baseWorldPos, normal, tiledUV, detailWeight);

        worldPos = applyBevel(worldPos, normal,
                              outwardA, distA, signedA,
                              outwardB, distB, signedB,
                              nearStrength);
    }

    worldPos = applyDistantRise(worldPos);
    worldPos = applyWorldCurvature(worldPos);

    return worldPos;
}

void main() {

    float u = gl_TessCoord.x;
    float v = gl_TessCoord.y;

    float sizeA   = teSizeA[0];
    float sizeB   = teSizeB[0];
    float natural = teNatural[0];

    vec3 normal   = teNormal[0];
    vec3 tangentA = normalize(teWorldPos[1] - teWorldPos[0]);
    vec3 tangentB = normalize(teWorldPos[3] - teWorldPos[0]);

    float tier0MaxSqDist = getTier0MaxSqDist();

    vec3 baseWorldPos = mix(mix(teWorldPos[0], teWorldPos[1], u),
                            mix(teWorldPos[3], teWorldPos[2], u), v);

    float nearStrength = getNearStrength(computeDistanceFromCenterSq(baseWorldPos), tier0MaxSqDist);

    vec3 worldPos = evalDisplacedSurface(
        u, v, baseWorldPos, sizeA, sizeB, natural, tangentA, tangentB, normal, nearStrength);

    if (nearStrength > 0.001) {

        float uStep = HEIGHT_FD_EPSILON_BLOCKS / sizeA;
        float vStep = HEIGHT_FD_EPSILON_BLOCKS / sizeB;

        uStep = (u + uStep <= 1.0) ?  uStep : -uStep;
        vStep = (v + vStep <= 1.0) ?  vStep : -vStep;

        vec3 baseU = mix(mix(teWorldPos[0], teWorldPos[1], u + uStep),
                         mix(teWorldPos[3], teWorldPos[2], u + uStep), v);
        vec3 baseV = mix(mix(teWorldPos[0], teWorldPos[1], u),
                         mix(teWorldPos[3], teWorldPos[2], u), v + vStep);

        float nsU = getNearStrength(computeDistanceFromCenterSq(baseU), tier0MaxSqDist);
        float nsV = getNearStrength(computeDistanceFromCenterSq(baseV), tier0MaxSqDist);

        vec3 posU = evalDisplacedSurface(
            u + uStep, v, baseU, sizeA, sizeB, natural, tangentA, tangentB, normal, nsU);
        vec3 posV = evalDisplacedSurface(
            u, v + vStep, baseV, sizeA, sizeB, natural, tangentA, tangentB, normal, nsV);

        vec3 tangentU = (posU - worldPos) / uStep;
        vec3 tangentV = (posV - worldPos) / vStep;

        if (length(tangentU) > 1e-6 && length(tangentV) > 1e-6) {
            vec3 fdNormal = normalize(cross(tangentU, tangentV));
            if (dot(fdNormal, normal) < 0.0)
            fdNormal = -fdNormal;
            normal = fdNormal;
        }
    }

    vLocalPos   = worldPos;
    vUVLocalPos = baseWorldPos;
    vNormal     = normal;
    vUVOrigin   = teUVOrigin[0];
    vOrient     = teOrient[0];
    vColor      = mix(mix(teColor[0], teColor[1], u),
                      mix(teColor[3], teColor[2], u), v);

    gl_Position = u_viewProjection * vec4(worldPos, 1.0);
}