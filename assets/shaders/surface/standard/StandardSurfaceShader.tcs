#version 400 core
layout(vertices = 4) out;

in  vec3  tcWorldPos[];
in  vec3  tcNormal[];
in  vec2  tcUVOrigin[];
in  float tcOrient[];
in  float tcColor[];
in  float tcQuadSize[];
in  float tcBevelMaskA0[];
in  float tcBevelMaskA1[];
in  float tcBevelMaskB0[];
in  float tcBevelMaskB1[];
in  float tcBevelNegMaskA0[];
in  float tcBevelNegMaskA1[];
in  float tcBevelNegMaskB0[];
in  float tcBevelNegMaskB1[];

out vec3  teWorldPos[];
out vec3  teNormal[];
out vec2  teUVOrigin[];
out float teOrient[];
out float teColor[];
out float teQuadSize[];
out float teBevelMaskA0[];
out float teBevelMaskA1[];
out float teBevelMaskB0[];
out float teBevelMaskB1[];
out float teBevelNegMaskA0[];
out float teBevelNegMaskA1[];
out float teBevelNegMaskB0[];
out float teBevelNegMaskB1[];

#include "includes/SettingsData.glsl"
#include "surface/includes/SurfaceTessellationTier.glsl"

/*
 * Ring gating compares this patch's own world-space center against
 * getTier0MaxSqDist()/getTier1MaxSqDist() (SurfaceTessellationTier.glsl)
 * via computeDistanceFromCenterSq() — the same per-position formula the
 * TES and FSH use — so all three stages agree on the same boundaries no
 * matter whether this patch is being drawn as part of an individually
 * rendered chunk or merged into a mega batch. The old approach compared
 * against a single u_distanceFromCenter value baked once per grid slot,
 * which every chunk folded into the same mega shared regardless of its
 * own true position — that's what let a mega and its individually
 * rendered neighbor pick different tiers for what should be the same
 * ring boundary. tcWorldPos is a TCS input, already valid for every
 * control point before this invocation runs, so reading all four corners
 * from inside the gl_InvocationID == 0 block is safe. Outside the near
 * ring, both tess levels are pinned to 1 — no interior vertices for the
 * TES's bevel/noise/height code to run on.
 *
 * levelA/levelB are always this quad's own block count along that axis
 * times a fixed density, never boosted by anything sampled from the
 * quad's own content. equal_spacing then places vertex k at exactly
 * k/density blocks from the patch's own corner, and since block corners
 * sit on an absolute world grid, two neighboring patches only agree on
 * every shared-edge vertex position if both derive their level from size
 * alone — a per-quad adaptive term would break that for any two
 * neighbors whose sampled content differs, at a true corner or a flat
 * coplanar seam alike.
 *
 * Near ring: level = size * NEAR_DENSITY, capped at 64 (the driver's
 * guaranteed ceiling, and exactly the max merged quad size of 16 — see
 * FullGeometryBranch.tryExpand — times 4).
 *
 * Far ring: level = size, one segment per block. GL_MAX_TESS_GEN_LEVEL is
 * only guaranteed >= 64, so a merged quad wider than that loses the
 * one-vertex-per-block guarantee for itself only; if that becomes
 * visible in practice the real fix is capping merged quad size during
 * greedy meshing, not raising this clamp.
 *
 * Mid ring: flat level 1. World curvature still runs here (applied in
 * StandardSurface.tes) but needs no density — its second derivative is a
 * constant everywhere, so a merged quad's worst-case sag depends only on
 * its own span, not on distance from center.
 */

void main() {
    gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;
    teWorldPos      [gl_InvocationID] = tcWorldPos      [gl_InvocationID];
    teNormal        [gl_InvocationID] = tcNormal        [gl_InvocationID];
    teUVOrigin      [gl_InvocationID] = tcUVOrigin      [gl_InvocationID];
    teOrient        [gl_InvocationID] = tcOrient        [gl_InvocationID];
    teColor         [gl_InvocationID] = tcColor         [gl_InvocationID];
    teQuadSize      [gl_InvocationID] = tcQuadSize      [gl_InvocationID];
    teBevelMaskA0   [gl_InvocationID] = tcBevelMaskA0   [gl_InvocationID];
    teBevelMaskA1   [gl_InvocationID] = tcBevelMaskA1   [gl_InvocationID];
    teBevelMaskB0   [gl_InvocationID] = tcBevelMaskB0   [gl_InvocationID];
    teBevelMaskB1   [gl_InvocationID] = tcBevelMaskB1   [gl_InvocationID];
    teBevelNegMaskA0[gl_InvocationID] = tcBevelNegMaskA0[gl_InvocationID];
    teBevelNegMaskA1[gl_InvocationID] = tcBevelNegMaskA1[gl_InvocationID];
    teBevelNegMaskB0[gl_InvocationID] = tcBevelNegMaskB0[gl_InvocationID];
    teBevelNegMaskB1[gl_InvocationID] = tcBevelNegMaskB1[gl_InvocationID];

    if (gl_InvocationID == 0) {

        float levelA;
        float levelB;

        float tier0MaxSqDist = getTier0MaxSqDist();
        float tier1MaxSqDist = getTier1MaxSqDist();

        vec3  patchCenter = (tcWorldPos[0] + tcWorldPos[1] + tcWorldPos[2] + tcWorldPos[3]) * 0.25;
        float patchDistSq = computeDistanceFromCenterSq(patchCenter);

        int   quadPack = int(tcQuadSize[0]);
        float sizeA    = float(quadPack & 0xFF);
        float sizeB    = float((quadPack >> 8) & 0xFF);

        if (patchDistSq <= tier0MaxSqDist) {

            const float NEAR_DENSITY = 4.0;

            levelA = clamp(sizeA * NEAR_DENSITY, 1.0, 64.0);
            levelB = clamp(sizeB * NEAR_DENSITY, 1.0, 64.0);

        } else if (patchDistSq > tier1MaxSqDist) {

            levelA = clamp(sizeA, 1.0, 64.0);
            levelB = clamp(sizeB, 1.0, 64.0);

        } else {
            levelA = 1.0;
            levelB = 1.0;
        }

        gl_TessLevelOuter[0] = levelB;
        gl_TessLevelOuter[1] = levelA;
        gl_TessLevelOuter[2] = levelB;
        gl_TessLevelOuter[3] = levelA;
        gl_TessLevelInner[0] = levelA;
        gl_TessLevelInner[1] = levelB;
    }
}