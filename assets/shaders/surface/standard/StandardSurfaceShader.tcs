#version 400 core
layout(vertices = 4) out;

in  vec3  tcWorldPos[];
in  vec3  tcNormal[];
in  vec2  tcUVOrigin[];
in  float tcOrient[];
in  vec3  tcColor[];
in  float tcSizeA[];
in  float tcSizeB[];
in  float tcNatural[];
in  vec4  tcEdge[];

out vec3  teWorldPos[];
out vec3  teNormal[];
out vec2  teUVOrigin[];
out float teOrient[];
out vec3  teColor[];
out float teSizeA[];
out float teSizeB[];
out float teNatural[];
out vec4  teEdge[];

#include "includes/SettingsData.glsl"
#include "includes/PlayerPositionData.glsl"
#include "surface/includes/SurfaceTessellationTier.glsl"

// Tessellation-level control point. The tier is resolved once per patch from the chunk that owns the
// patch's origin block, so every patch of a chunk agrees and the two perpendicular faces of one block can
// no longer land in different chunks and pick different densities along the edge they share. Level scales
// with the edge's block length in every tier, which fixes vertex spacing at 0.25 blocks near and 1.0
// blocks beyond; with merges capped at ten blocks the near level tops out at 40 and never approaches the
// hardware clamp.

void main() {
    gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;
    teWorldPos[gl_InvocationID] = tcWorldPos[gl_InvocationID];
    teNormal  [gl_InvocationID] = tcNormal  [gl_InvocationID];
    teUVOrigin[gl_InvocationID] = tcUVOrigin[gl_InvocationID];
    teOrient  [gl_InvocationID] = tcOrient  [gl_InvocationID];
    teColor   [gl_InvocationID] = tcColor   [gl_InvocationID];
    teSizeA   [gl_InvocationID] = tcSizeA   [gl_InvocationID];
    teSizeB   [gl_InvocationID] = tcSizeB   [gl_InvocationID];
    teNatural [gl_InvocationID] = tcNatural [gl_InvocationID];
    teEdge    [gl_InvocationID] = tcEdge    [gl_InvocationID];

    if (gl_InvocationID == 0) {

        float tier0MaxSqDist = getTier0MaxSqDist();
        float tier1MaxSqDist = getTier1MaxSqDist();

        vec3  chunkCenter = getOriginBlockChunkCenter(
            tcWorldPos[0], tcWorldPos[1], tcWorldPos[3], tcNormal[0]);

        float chunkDistSq = computeDistanceFromCenterSq(chunkCenter);

        float levelA = getEdgeTessLevel(chunkDistSq, tcSizeA[0], tier0MaxSqDist, tier1MaxSqDist);
        float levelB = getEdgeTessLevel(chunkDistSq, tcSizeB[0], tier0MaxSqDist, tier1MaxSqDist);

        gl_TessLevelOuter[0] = levelB;
        gl_TessLevelOuter[1] = levelA;
        gl_TessLevelOuter[2] = levelB;
        gl_TessLevelOuter[3] = levelA;
        gl_TessLevelInner[0] = levelA;
        gl_TessLevelInner[1] = levelB;
    }
}